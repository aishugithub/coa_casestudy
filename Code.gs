};      // caseId -> { qid: question text }
var CASE_INFO = {
 "cyber": {
  "dept": "Cyber Security & IoT",
  "title": "The Monday Morning Hack",
  "debrief": [
   "Starvation in a daisy chain (B1, C3, C4)",
   "Vectored interrupts and the vector table (A3, B2)",
   "User vs supervisor mode and privileged instructions (B3)",
   "DMA set-up and burst vs cycle stealing (B4, C1, C2)",
   "Putting it all together (D1)"
  ]
 },
 "aiml": {
  "dept": "AI & ML",
  "title": "The Cart That Kept Freezing",
  "debrief": [
   "Busy waiting vs interrupts (B1, C1)",
   "Daisy chain priority and starvation (A2, B2)",
   "Exceptions and user vs supervisor mode (B3)",
