};          // caseId -> { qid: correct option text }
var QTEXT = {
 "cyber": {
  "A1": "According to the case, which device is nearest to the processor in the daisy chain?",
  "A2": "The gateway uses IN and OUT instructions with a separate I/O address space. This means it uses:",
