/**
 * ============================================================================
 * COA UNIT 5 CASE STUDY — Google Apps Script backend (Code.gs)
 * ============================================================================
 * WHAT THIS IS:
 * Receives each submission from index.html, auto-scores the 13 MCQs against
 * the answer key below, writes ONE ROW to the "Responses" tab, and refreshes
 * the "Summary" tab (class % correct per question, per case) — project that
 * tab in class for the debrief.
 *
 *   [index.html on GitHub Pages] --POST JSON--> doPost(e) --score--> Sheet
 *
 * GENERATED by build.py from cases.py. The answer TEXT must match the option
 * text in index.html exactly — so edit cases.py and rebuild, never by hand.
 * ============================================================================
 */

var RESP_SHEET = 'Responses';
var SUMMARY_SHEET = 'Summary';

/* ---- Answer key and question text (from cases.py) ------------------------ */
var KEY = __KEY__;          // caseId -> { qid: correct option text }
var QTEXT = __QTEXT__;      // caseId -> { qid: question text }
var CASE_INFO = __INFO__;   // caseId -> { dept, title, debrief: [...] }

var QIDS = ['A1','A2','A3','A4','B1','B2','B3','B4','C1','C2','C3','C4','D1'];

/* ---- Column order (single source of truth for header + every row) -------- */
var HEADERS = ['submittedAt','regno','name','dept','caseId']
  .concat(QIDS)
  .concat(['score_A','score_B','score_C','score_D','total_score'])
  .concat(QIDS.map(function (q) { return 'ok_' + q; }))
  .concat(['readSeconds','totalSeconds','userAgent']);

/** scoreRecord(data) — adds ok_*, score_A/B/C and total_score to data. */
function scoreRecord(data) {
  var key = KEY[data.caseId] || {};
  var part = { A:0, B:0, C:0, D:0 };
  QIDS.forEach(function (q) {
    var ok = (data[q] !== undefined && key[q] !== undefined && String(data[q]) === String(key[q])) ? 1 : 0;
    data['ok_' + q] = ok;
    part[q.charAt(0)] += ok;
  });
  data.score_A = part.A; data.score_B = part.B; data.score_C = part.C; data.score_D = part.D;
  data.total_score = part.A + part.B + part.C + part.D;   // out of 13
  return data;
}

function doPost(e) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    if (!e || !e.postData || !e.postData.contents) return json({ ok:false, error:'no post body' });
    var data = scoreRecord(JSON.parse(e.postData.contents));
    var sheet = getSheet_(RESP_SHEET);
    if (sheet.getLastRow() === 0) { sheet.appendRow(HEADERS); sheet.setFrozenRows(1); }
    sheet.appendRow(HEADERS.map(function (k) { var v = data[k]; return (v === undefined || v === null) ? '' : v; }));
    try { updateSummary(); } catch (err2) { /* never lose a submission because of the summary */ }
    return json({ ok:true, total:data.total_score });
  } catch (err) {
    return json({ ok:false, error:String(err) });
  } finally {
    lock.releaseLock();
  }
}

function doGet() {
  return json({ ok:true, message:'Unit 5 case-study endpoint is live. Submissions are POSTed by the case page.' });
}

/**
 * updateSummary() — rebuilds the Summary tab from all Responses.
 * If a student submitted twice, only their LATEST submission is counted.
 * Can also be run by hand: menu "Case study → Refresh summary".
 */
function updateSummary() {
  var resp = getSheet_(RESP_SHEET);
  var values = resp.getDataRange().getValues();
  var out = [['Unit 5 case study — class summary', '', '', 'Updated: ' + new Date().toLocaleString()], ['', '', '', '']];
  if (values.length < 2) { writeSummary_(out.concat([['No submissions yet.', '', '', '']])); return; }

  var head = values[0], col = {};
  head.forEach(function (h, i) { col[h] = i; });

  // latest submission per (regno, caseId)
  var latest = {};
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    latest[row[col.regno] + '|' + row[col.caseId]] = row;
  }
  var byCase = {};
  Object.keys(latest).forEach(function (k) {
    var row = latest[k], c = row[col.caseId];
    (byCase[c] = byCase[c] || []).push(row);
  });

  Object.keys(CASE_INFO).forEach(function (c) {
    var rows = byCase[c] || [];
    var info = CASE_INFO[c];
    out.push([info.dept + ' — "' + info.title + '"', 'Students: ' + rows.length,
              rows.length ? 'Average: ' + avg_(rows, col.total_score).toFixed(1) + ' / 13' : '', '']);
    out.push(['Q', 'Question', '% correct', 'Re-teach?']);
    QIDS.forEach(function (q) {
      var pct = rows.length ? Math.round(100 * avg_(rows, col['ok_' + q])) : '';
      out.push([q, QTEXT[c][q], pct === '' ? '' : pct + '%', (pct !== '' && pct < 60) ? '⚠ discuss in class' : '']);
    });
    out.push(['', 'Debrief points: ' + info.debrief.join(' · '), '', '']);
    out.push(['', '', '', '']);
  });
  writeSummary_(out);
}

function avg_(rows, idx) {
  var s = 0; rows.forEach(function (r) { s += Number(r[idx]) || 0; });
  return rows.length ? s / rows.length : 0;
}

function writeSummary_(out) {
  var sh = getSheet_(SUMMARY_SHEET);
  sh.clear();
  sh.getRange(1, 1, out.length, 4).setValues(out);
  sh.getRange(1, 1).setFontWeight('bold').setFontSize(13);
  sh.setColumnWidth(1, 60); sh.setColumnWidth(2, 520); sh.setColumnWidth(3, 110); sh.setColumnWidth(4, 160);
  sh.getRange(1, 2, out.length, 1).setWrap(true);
  for (var i = 0; i < out.length; i++) {
    if (out[i][0] === 'Q') sh.getRange(i + 1, 1, 1, 4).setFontWeight('bold').setBackground('#eef4fb');
    else if (String(out[i][1]).indexOf('Students:') === 0) sh.getRange(i + 1, 1, 1, 4).setFontWeight('bold');
  }
}

function getSheet_(name) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName(name) || ss.insertSheet(name);
}

function onOpen() {
  SpreadsheetApp.getUi().createMenu('Case study').addItem('Refresh summary', 'updateSummary').addToUi();
}

function json(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
